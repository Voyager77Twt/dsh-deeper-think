  "description": "v5 protocol toggle for no-oracle tasks: structured evidence + host-side falsifiable checks",
  "author": "七七 (Voyager77Twt)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Voyager77Twt/dsh-deeper-think.git"
  },
